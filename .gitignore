# Dependencies
node_modules/

# Index and database (contains your full like history — never commit)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment — .env.example is the tracked template
.env
.env.local
.env.*.local
!.env.example

# Dev-only sourcemap. public/app.js is committed; the map is 1.1 MB of library
# sources and would churn on every build.
public/app.js.map

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
*.heapsnapshot
*.cpuprofile

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# Editors and IDEs
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.netrwhist

# Scratch space
tmp/
temp/
.cache/
*.bak
*.orig
